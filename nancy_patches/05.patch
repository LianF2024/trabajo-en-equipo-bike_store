+@{
+    ViewData["Title"] = "Clientes";
+    var hasFilters = !string.IsNullOrWhiteSpace(ViewBag.Cedula as string) || !string.IsNullOrWhiteSpace(ViewBag.Apellido as string);
+}
+
+<div class="page-head">
+    <div>
+        <span class="eyebrow">RELACIONES</span>
+        <h1>Clientes</h1>
+        <p>Consulte por cédula/RUC o apellido. Registros encontrados: <strong>@Model.Count</strong>.</p>
+    </div>
+    <a class="button primary" asp-action="Crear">+ Nuevo cliente</a>
+</div>
+
+<form method="get" class="filters" role="search">
+    <label>
+        Cédula/RUC
+        <input name="cedula" value="@ViewBag.Cedula" inputmode="numeric" minlength="3" maxlength="13" autocomplete="off" />
+    </label>
+    <label>
+        Apellido
+        <input name="apellido" value="@ViewBag.Apellido" maxlength="100" autocomplete="family-name" />
+    </label>
+    <button type="submit" class="button dark">Filtrar</button>
+    @if (hasFilters)
+    {
+        <a class="button ghost" asp-action="Index">Limpiar filtros</a>
+    }
+</form>
+
+<div class="table-card">
+    <table>
+        <thead>
+            <tr><th>Cédula/RUC</th><th>Cliente</th><th>Contacto</th><th>Acciones</th></tr>
+        </thead>
+        <tbody>
+        @foreach (var item in Model)
+        {
+            <tr>
+                <td>@item.Identification</td>
+                <td class="strong">@item.FullName</td>
+                <td>@(item.Phone ?? "—")<br /><small>@(item.Email ?? "Sin correo")</small></td>
+                <td class="actions">
+                    <a asp-action="Editar" asp-route-id="@item.Id"><i class="bi bi-pencil"></i> Editar</a>
+                    <a asp-controller="Ventas" asp-action="Index" asp-route-clienteId="@item.Id"><i class="bi bi-receipt"></i> Ventas</a>
+                    <form asp-action="Eliminar" asp-route-id="@item.Id" method="post" data-confirm="¿Eliminar al cliente @item.FullName?">
+                        <button type="submit" class="link danger"><i class="bi bi-trash"></i> Eliminar</button>
+                    </form>
+                </td>
+            </tr>
+        }
+        @if (!Model.Any())
+        {
+            <tr><td colspan="4" class="empty">@(hasFilters ? "No existen clientes que coincidan con los filtros." : "No hay clientes registrados.")</td></tr>
+        }
+        </tbody>
+    </table>
+</div>
