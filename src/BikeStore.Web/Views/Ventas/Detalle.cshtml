@model VentaVm
@{ ViewData["Title"] = $"Venta #{Model.Id}"; }
<div class="detail-head"><div><a class="back" asp-action="Index">← Volver al historial</a><span class="eyebrow">COMPROBANTE INTERNO</span><h1>Venta #@Model.Id</h1><p>@Model.Date.ToString("dddd, dd 'de' MMMM 'de' yyyy · HH:mm")</p></div><span class="status ok">Registrada</span></div>
<div class="detail-grid"><section class="info-card"><span>CLIENTE</span><strong>@Model.Customer</strong><a asp-action="Index" asp-route-clienteId="@Model.CustomerId">Ver todas sus ventas</a></section><section class="totals"><div><span>Subtotal</span><strong>@Model.Subtotal.ToString("C2")</strong></div><div><span>IVA</span><strong>@Model.Vat.ToString("C2")</strong></div><div class="grand"><span>Total</span><strong>@Model.Total.ToString("C2")</strong></div></section></div>
<div class="table-card"><table><thead><tr><th>Bicicleta</th><th class="number">Cantidad</th><th class="number">Precio unitario</th><th class="number">Subtotal</th></tr></thead><tbody>@foreach(var item in Model.Details){<tr><td class="strong">@item.Bicycle</td><td class="number">@item.Quantity</td><td class="number">@item.UnitPrice.ToString("C2")</td><td class="number strong">@item.Subtotal.ToString("C2")</td></tr>}</tbody></table></div>
